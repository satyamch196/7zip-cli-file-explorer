def list_directory(dir):
	if dir=="":
		if empty_dir==1:
			print("Directory",PWD.split("/")[-2],"is empty")
			return
		elif PWD==root:
			name=list(fs_dict.keys())[0]
			print("📁",name,"(Directory)")
			return
#			key=list(fs_dict.keys())[0]
		else:
			key=PWD[len(root):len(PWD)-1]
		for item in fs_dict[key]:
			if isinstance(item, tuple) and len(item) == 2:
				name, metadata = item
				if isinstance(metadata, tuple):
					if len(metadata) == 2:
						print("📁",name,"(Directory) - Created on",metadata[0],"at",metadata[1])
					elif len(metadata) == 4:
						print("📄",name,"(File) - Created on",metadata[0],"at",metadata[1],"Size:",size_format(metadata[2]), "Compressed:",size_format(metadata[3]))
					else:
						print("⚠️ ",name,"- Unknown metadata format:",metadata)
				else:
					print("⚠️ ",name,"- Invalid metadata format:",metadata)
			else:
				print("⚠️ Invalid item format:",item)
def file_explorer():
	try:
		global PWD,old_wrk_dir,empty_dir
		old_wrk_dir=root
		PWD=root
		empty_dir=0
		while True:
			print("╭─ "+style+PWD+reset)
			print("╰─ ",end="")
			cmd=input().split()
			if len(cmd)==0:
				continue
			if cmd[0]=="cd":
				old_wrk_dir=PWD
				PWD=change_current_dir(cmd)
			elif cmd[0]=="pwd":
				print(PWD[len(root)-1:])
			elif cmd[0]=="ls":
				if len(cmd)==2:
					if list_directory(cmd[1:])==False:
						print("ls : directory",cmd[1:],"does not exist")
					else:
						list_directory(cmd[1:])
				elif len(cmd)==1:
					list_directory("")
			elif cmd[0] in ["find"]:
