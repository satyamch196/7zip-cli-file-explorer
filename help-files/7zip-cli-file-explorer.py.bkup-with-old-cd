		PWD, old_wrk_dir = old_wrk_dir, PWD
		return PWD

	dir_arg = " ".join(cmd[1:]).strip()
	prev_pwd = PWD
	empty_dir = 0

	# --- Helper functions ---
	def up_one(path):
		if path == root:
			return root
		parts = path.strip("/").split("/")
		if len(parts) <= 1:
			return root
		return "/".join(parts[:-1]) + "/"

	def up_two(path):
		if path == root:
			return root
		parts = path.strip("/").split("/")
		if len(parts) <= 2:
			return root
		return "/".join(parts[:-2]) + "/"

	# --- Handle absolute paths ---
	# If cd starts with / or ~, treat as root-based
	if dir_arg and dir_arg[0] in ["~", "/"]:
		PWD = root
		# Remove the first slash or tilde so that the remainder
		# behaves like a relative path under root
		dir_arg = dir_arg.lstrip("~/")

	# --- Split and process path segments ---
	parts = [p for p in dir_arg.split("/") if p]

	for part in parts:
		if part == ".":
			continue
		elif part == "..":
			PWD = up_one(PWD)
		elif part == "...":
			PWD = up_two(PWD)
		elif part == "~":
			PWD = root
		elif "*" in part:
			print(red + "Wildcards aren't supported!" + reset)
			return old_wrk_dir
		else:
			new_path = (PWD.rstrip("/") + "/" + part).rstrip("/") + "/"

			if new_path.rstrip("/") in fs_dict:
				old_wrk_dir = PWD
				PWD = new_path
			else:
				parent = PWD.rstrip("/")
				if parent in fs_dict:
					children = [c[0] for c in fs_dict[parent]]
					if part in children:
						PWD = new_path
						empty_dir = 1
					else:
						print(red + f"cd: Directory '{dir_arg}' does not exist!" + reset)
						return prev_pwd
				else:
					print(red + f"cd: Directory '{dir_arg}' does not exist!" + reset)
					return prev_pwd

	# --- Normalize path ---
	PWD = re.sub(r'/+', '/', PWD)
	if not PWD.endswith("/"):
		PWD += "/"

	return PWD
